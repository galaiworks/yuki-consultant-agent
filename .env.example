# ---- Anthropic(当面は galaiworks のキー。サーバー側のみ) ----
ANTHROPIC_API_KEY=

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。ブラウザに出さない
SUPABASE_SERVICE_ROLE_KEY=

# ---- アプリ ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# open = 招待済みクライアントは無料で利用(テスト期間)
# paid = 有効なサブスク(Stripe)か特別チケットが必要
ACCESS_MODE=open
# open モードで付与するプラン
DEFAULT_PLAN_ID=founding
# true にすると、Guardian 合格後の成果物を管理者確認待ちにする
DELIVERABLE_HUMAN_REVIEW=false
# /api/jobs/run を外部(Vercel Cron 等)から叩くための合言葉
CRON_SECRET=

# ---- 埋め込み(任意。未設定なら全文検索のみ) ----
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-multilingual-2

# ---- Stripe(課金開始時に設定) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
